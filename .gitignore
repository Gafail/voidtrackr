# dependencies
node_modules/

# build output
dist/
dist-api/

# editors / OS
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# logs
*.log

# Generated by the CLI and the test suite.
test/out/

# The model is fetched with `npm run model`. The provenance note beside it is
# kept, because it records where the weights came from.
public/model/model.json
public/model/group1-shard1of1.bin

# The ONNX model weights are fetched with `npm run model`, `npm run model:okarina`,
# `npm run model:tsumugi`, `npm run model:yourmt3` and `npm run model:piano`.
# They live outside `public/` so the build step copies them in rather than
# the repository carrying them. The provenance note beside them is kept.
models/onnx/*.onnx
models/onnx/**/*.onnx
models/onnx/**/*.onnx.data
models/onnx/**/*.bin
models/onnx/**/*.json

# Evaluation output.
eval/

# The music this was tuned on. Large, private, and not part of the code.
Music Import/
