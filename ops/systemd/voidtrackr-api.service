# voidtrackr — the API server.
#
# The site itself is static and served by nginx. This is the part that
# describes the tool to a program: which models there are, what licences
# they carry, what a conversion takes, and where the model's weights are.
#
# It does not convert anything, and it never receives a recording. There is
# no endpoint that takes one and the server never reads a request body, so
# the promise that a recording stays on the machine it is on holds here as
# well as it does in the browser.
#
# It listens on 127.0.0.1 only. nginx is the only thing that can reach it,
# and it is the only thing that should.

[Unit]
Description=voidtrackr API
Documentation=https://github.com/Gafail/voidtrackr
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/voidtrackr/api

Environment=NODE_ENV=production
Environment=VOIDTRACKR_HOST=127.0.0.1
Environment=VOIDTRACKR_PORT=8787

ExecStart=/usr/bin/node /opt/voidtrackr/api/server.js

Restart=on-failure
RestartSec=3
TimeoutStopSec=20

# The server has no dependencies and holds nothing in memory: it answers
# with JSON and reads nothing. The limit is there to say so, and to stop it
# becoming a way to exhaust the box if that ever changes.
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
